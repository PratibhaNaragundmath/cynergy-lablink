# LabLink Environment Variables Example
# Copy this file to .env.local to configure real Firebase and Gemini API keys

# Gemini AI API Configuration (Keep secret on server side or use proxy)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional - Local in-memory/localStorage fallback active by default)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=lablink-campus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lablink-campus
VITE_FIREBASE_STORAGE_BUCKET=lablink-campus.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
