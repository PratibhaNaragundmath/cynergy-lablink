# ==========================================
# Django Authentication Demo Environment Variables
# Copy this file to .env and fill in your credentials
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-demo-secret-key-change-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP Configuration
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password below
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_gmail@gmail.com

# Google OAuth 2.0 Credentials (django-allauth)
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Set Authorized Redirect URI: http://127.0.0.1:8000/accounts/google/login/callback/
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OTP Expiry Settings (in seconds)
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
